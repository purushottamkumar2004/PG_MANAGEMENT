# Copy to .env and fill in
DATABASE_URL=postgresql://pg:pg@localhost:5432/pg_dev
TZ=Asia/Kolkata
# Tests wipe this database — never point it at real data
TEST_DATABASE_URL=postgresql://pg:pg@localhost:5432/pg_test
# Required: secret used to sign login tokens. Use a long random value in production.
JWT_SECRET=change-me-to-a-long-random-string
# Optional: token lifetime (default 30d)
JWT_EXPIRES_IN=30d
# Optional: API port (default 4000)
PORT=4000
