    "test": "vitest run"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "dotenv": "18.0.9",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11",
    "vitest": "5.0.5"
  }
}
